<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FoodSaver — Zero Waste Kitchen</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Serif+Display&display=swap" rel="stylesheet">
<style>
  :root {
    --g900:#0f2409;--g800:#1a3a0a;--g700:#27500a;--g600:#3B6D11;--g500:#639922;
    --g400:#97C459;--g300:#C0DD97;--g200:#DFF0C0;--g100:#EAF3DE;--g50:#f4faea;
    --amber:#BA7517;--amber-bg:#FAEEDA;--red:#A32D2D;--red-bg:#FCEBEB;
    --white:#ffffff;--surface:#f7fcf2;--card:#ffffff;--border:#dff0c0;
    --text:#0f2409;--text-muted:#6a8a55;--shadow:0 2px 12px rgba(59,109,17,0.08);
    --radius:16px;--radius-sm:10px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:'DM Sans',sans-serif;background:var(--surface);color:var(--text);min-height:100vh;font-size:15px;}
  .app{display:flex;flex-direction:column;min-height:100vh;max-width:480px;margin:0 auto;background:var(--white);box-shadow:0 0 40px rgba(0,0,0,0.08);position:relative;}
  .screen{display:none;flex-direction:column;min-height:100vh;}
  .screen.active{display:flex;}
  .topbar{background:var(--g600);color:white;padding:48px 20px 20px;flex-shrink:0;}
  .topbar-row{display:flex;align-items:center;gap:10px;}
  .back-btn{width:32px;height:32px;border-radius:10px;background:rgba(255,255,255,0.18);border:none;color:white;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.15s;}
  .back-btn:hover{background:rgba(255,255,255,0.28);}
  .topbar h1{font-family:'DM Serif Display',serif;font-size:26px;font-weight:400;}
  .topbar .sub{font-size:13px;color:var(--g300);margin-top:3px;}
  .topbar-actions{margin-left:auto;display:flex;gap:8px;}
  .icon-btn{width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,0.15);border:none;color:white;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background 0.15s;}
  .icon-btn:hover{background:rgba(255,255,255,0.25);}
  .screen-body{flex:1;overflow-y:auto;padding-bottom:80px;background:var(--g50);}
  .search-wrap{padding:14px 16px 4px;}
  .search-box{display:flex;align-items:center;gap:10px;background:var(--white);border:1.5px solid var(--border);border-radius:50px;padding:10px 16px;transition:border-color 0.2s;}
  .search-box:focus-within{border-color:var(--g500);}
  .search-box input{border:none;outline:none;font-family:'DM Sans',sans-serif;font-size:14px;color:var(--text);background:transparent;flex:1;}
  .search-box input::placeholder{color:#aac88a;}
  .section-head{display:flex;align-items:center;justify-content:space-between;padding:16px 16px 8px;}
  .section-title{font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;}
  .section-count{font-size:11px;color:var(--text-muted);}
  .section-title.urgent{color:var(--red);}
  .section-title.warn{color:var(--amber);}
  .section-title.fresh{color:var(--g600);}
  .food-list{padding:0 16px;display:flex;flex-direction:column;gap:8px;}
  .food-card{background:var(--white);border-radius:var(--radius-sm);border:1.5px solid var(--border);padding:12px 14px;display:flex;align-items:center;gap:12px;transition:all 0.18s;cursor:pointer;position:relative;overflow:hidden;animation:fadeIn 0.2s ease;}
  .food-card:hover{border-color:var(--g400);transform:translateY(-1px);box-shadow:var(--shadow);}
  .food-card.urgent-card{border-left:3px solid var(--red);}
  .food-card.warn-card{border-left:3px solid var(--amber);}
  .food-emoji{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
  .food-emoji.fresh-bg{background:var(--g100);}
  .food-emoji.warn-bg{background:var(--amber-bg);}
  .food-emoji.urgent-bg{background:var(--red-bg);}
  .food-info{flex:1;min-width:0;}
  .food-name{font-size:14px;font-weight:500;color:var(--g800);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .food-meta{font-size:12px;color:var(--text-muted);margin-top:2px;}
  .food-badge{font-size:11px;font-weight:500;padding:4px 10px;border-radius:20px;flex-shrink:0;}
  .badge-fresh{background:var(--g100);color:var(--g600);}
  .badge-warn{background:var(--amber-bg);color:var(--amber);}
  .badge-urgent{background:var(--red-bg);color:var(--red);}
  .food-actions{display:flex;gap:6px;margin-left:4px;}
  .action-btn{width:28px;height:28px;border-radius:8px;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;transition:all 0.15s;}
  .edit-btn{background:var(--g100);color:var(--g600);}
  .edit-btn:hover{background:var(--g300);}
  .del-btn{background:var(--red-bg);color:var(--red);}
  .del-btn:hover{background:#f7c1c1;}
  .empty-state{text-align:center;padding:60px 30px;color:var(--text-muted);}
  .empty-state .empty-icon{font-size:52px;margin-bottom:16px;opacity:0.6;}
  .empty-state .empty-title{font-size:18px;font-weight:500;color:var(--g700);margin-bottom:8px;}
  .empty-state p{font-size:14px;line-height:1.6;}
  .empty-cta{display:inline-block;margin-top:20px;padding:12px 24px;background:var(--g600);color:white;border-radius:50px;font-size:14px;font-weight:500;cursor:pointer;border:none;font-family:'DM Sans',sans-serif;transition:background 0.2s;}
  .empty-cta:hover{background:var(--g700);}
  .fab{position:fixed;bottom:90px;right:calc(50% - 480px/2 + 20px);width:52px;height:52px;border-radius:50%;background:var(--g600);color:white;border:none;font-size:26px;cursor:pointer;box-shadow:0 4px 20px rgba(59,109,17,0.35);display:flex;align-items:center;justify-content:center;transition:all 0.2s;z-index:10;}
  .fab:hover{background:var(--g700);transform:scale(1.07);}
  .fab:active{transform:scale(0.96);}
  .bottom-nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:480px;background:var(--white);border-top:1.5px solid var(--border);display:flex;padding:10px 0 20px;z-index:20;}
  .nav-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px;cursor:pointer;transition:opacity 0.15s;}
  .nav-item:hover{opacity:0.75;}
  .nav-icon{width:24px;height:24px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:15px;}
  .nav-icon.active{background:var(--g100);}
  .nav-label{font-size:10px;font-weight:500;}
  .nav-label.active{color:var(--g600);}
  .nav-label.inactive{color:#bbb;}
  .stats-bar{display:flex;gap:8px;padding:12px 16px;}
  .stat-card{flex:1;background:var(--white);border-radius:var(--radius-sm);border:1.5px solid var(--border);padding:10px 12px;text-align:center;}
  .stat-num{font-size:22px;font-weight:600;color:var(--g600);font-family:'DM Serif Display',serif;}
  .stat-label{font-size:10px;color:var(--text-muted);margin-top:2px;}
  .add-body{flex:1;padding:20px 16px 100px;background:var(--g50);overflow-y:auto;}
  .field-group{margin-bottom:18px;}
  .field-label{font-size:12px;font-weight:600;color:var(--g700);margin-bottom:7px;letter-spacing:0.3px;}
  .field-input{width:100%;background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-sm);padding:11px 14px;font-size:14px;font-family:'DM Sans',sans-serif;color:var(--text);outline:none;transition:border-color 0.2s;}
  .field-input:focus{border-color:var(--g500);}
  .qty-row{display:flex;gap:10px;align-items:center;}
  .qty-btn{width:36px;height:36px;border-radius:10px;background:var(--g100);border:1.5px solid var(--border);font-size:20px;color:var(--g600);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all 0.15s;}
  .qty-btn:hover{background:var(--g200);}
  .qty-val{font-size:18px;font-weight:600;color:var(--g800);min-width:32px;text-align:center;}
  .unit-select{flex:1;background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-sm);padding:9px 12px;font-size:13px;font-family:'DM Sans',sans-serif;color:var(--text);outline:none;cursor:pointer;}
  .pills-row{display:flex;gap:8px;flex-wrap:wrap;}
  .pill{padding:7px 14px;border-radius:20px;font-size:13px;cursor:pointer;border:1.5px solid var(--border);background:var(--white);color:var(--g700);transition:all 0.15s;font-family:'DM Sans',sans-serif;}
  .pill:hover{border-color:var(--g400);background:var(--g100);}
  .pill.selected{background:var(--g600);color:white;border-color:var(--g600);}
  .save-btn{width:100%;background:var(--g600);color:white;border:none;border-radius:var(--radius-sm);padding:15px;font-size:16px;font-weight:500;font-family:'DM Sans',sans-serif;cursor:pointer;margin-top:10px;transition:all 0.2s;}
  .save-btn:hover{background:var(--g700);}
  .save-btn:active{transform:scale(0.98);}
  .alert-card{background:var(--white);border-radius:var(--radius-sm);border:1.5px solid var(--border);margin:0 16px 10px;padding:14px;position:relative;overflow:hidden;}
  .alert-card.urgent{border-left:4px solid var(--red);}
  .alert-card.warn{border-left:4px solid var(--amber);}
  .alert-card.info{border-left:4px solid var(--g500);}
  .alert-header{display:flex;justify-content:space-between;align-items:flex-start;}
  .alert-title{font-size:14px;font-weight:500;color:var(--g800);}
  .alert-time{font-size:11px;color:#bbb;}
  .alert-body{font-size:13px;color:var(--text-muted);margin-top:5px;line-height:1.5;}
  .alert-actions{display:flex;gap:10px;margin-top:10px;}
  .alert-action-btn{font-size:12px;font-weight:500;padding:5px 12px;border-radius:20px;border:1.5px solid var(--border);background:var(--white);color:var(--g600);cursor:pointer;transition:all 0.15s;font-family:'DM Sans',sans-serif;}
  .alert-action-btn:hover{background:var(--g100);}
  .settings-body{flex:1;overflow-y:auto;padding-bottom:80px;background:var(--g50);}
  .profile-card{background:var(--white);border-radius:var(--radius);border:1.5px solid var(--border);margin:16px;padding:16px;display:flex;align-items:center;gap:14px;cursor:pointer;transition:all 0.15s;}
  .profile-card:hover{border-color:var(--g400);}
  .avatar{width:50px;height:50px;border-radius:50%;background:var(--g100);display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:600;color:var(--g600);flex-shrink:0;}
  .settings-section-label{font-size:11px;font-weight:600;color:var(--text-muted);letter-spacing:1px;text-transform:uppercase;padding:4px 16px 8px;}
  .settings-group{background:var(--white);border-radius:var(--radius-sm);border:1.5px solid var(--border);margin:0 16px 16px;overflow:hidden;}
  .settings-row{display:flex;align-items:center;padding:13px 14px;gap:12px;border-bottom:1px solid var(--g50);cursor:pointer;transition:background 0.15s;}
  .settings-row:last-child{border-bottom:none;}
  .settings-row:hover{background:var(--g50);}
  .s-icon{font-size:18px;width:22px;text-align:center;flex-shrink:0;}
  .s-text{flex:1;}
  .s-name{font-size:14px;color:var(--g800);}
  .s-sub{font-size:12px;color:var(--text-muted);margin-top:1px;}
  .s-arrow{color:#ccc;font-size:16px;}
  .toggle{width:42px;height:24px;border-radius:12px;position:relative;cursor:pointer;transition:background 0.25s;flex-shrink:0;}
  .toggle.on{background:var(--g600);}
  .toggle.off{background:#ddd;}
  .toggle-knob{width:18px;height:18px;border-radius:50%;background:white;position:absolute;top:3px;transition:left 0.25s;}
  .toggle.on .toggle-knob{left:21px;}
  .toggle.off .toggle-knob{left:3px;}
  .version-text{text-align:center;padding:12px;font-size:12px;color:#bbb;}
  .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.4);z-index:100;align-items:flex-end;justify-content:center;}
  .modal-overlay.open{display:flex;}
  .modal{background:white;border-radius:20px 20px 0 0;padding:20px 20px 40px;width:100%;max-width:480px;animation:slideUp 0.25s ease;}
  @keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
  .modal-handle{width:40px;height:4px;background:#e0e0e0;border-radius:2px;margin:0 auto 16px;}
  .modal-title{font-size:16px;font-weight:600;color:var(--g800);margin-bottom:14px;}
  .modal-actions{display:flex;gap:10px;margin-top:16px;}
  .btn-cancel{flex:1;padding:12px;border-radius:10px;border:1.5px solid var(--border);background:white;font-family:'DM Sans',sans-serif;font-size:14px;cursor:pointer;color:var(--text);}
  .btn-confirm{flex:1;padding:12px;border-radius:10px;border:none;background:var(--red);color:white;font-family:'DM Sans',sans-serif;font-size:14px;cursor:pointer;font-weight:500;}
  .toast{position:fixed;bottom:100px;left:50%;transform:translateX(-50%) translateY(20px);background:var(--g800);color:white;padding:10px 20px;border-radius:50px;font-size:13px;z-index:200;opacity:0;transition:all 0.3s;pointer-events:none;white-space:nowrap;}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
  @keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
  @media(max-width:500px){.fab{right:20px;}.bottom-nav{left:0;transform:none;}}
</style>
</head>
<body>
<div class="app">
 
  <!-- HOME -->
  <div class="screen active" id="screen-home">
    <div class="topbar">
      <div class="topbar-row">
        <div>
          <h1>FoodSaver</h1>
          <p class="sub" id="home-subtitle">Your pantry is empty</p>
        </div>
        <div class="topbar-actions">
          <button class="icon-btn" onclick="showScreen('alerts')">🔔</button>
        </div>
      </div>
    </div>
    <div class="screen-body">
      <div class="stats-bar">
        <div class="stat-card"><div class="stat-num" id="stat-total">0</div><div class="stat-label">Total items</div></div>
        <div class="stat-card"><div class="stat-num" style="color:var(--red)" id="stat-expiring">0</div><div class="stat-label">Expiring soon</div></div>
        <div class="stat-card"><div class="stat-num" style="color:var(--g500)" id="stat-fresh">0</div><div class="stat-label">Fresh items</div></div>
      </div>
      <div class="search-wrap">
        <div class="search-box">
          <span style="color:#aac88a;font-size:14px;">🔍</span>
          <input type="text" placeholder="Search food items..." id="search-input" oninput="renderHome()">
        </div>
      </div>
      <div id="home-list"></div>
    </div>
    <button class="fab" onclick="openAdd()">+</button>
    <div class="bottom-nav">
      <div class="nav-item" onclick="showScreen('home')"><div class="nav-icon active">🏠</div><span class="nav-label active">Home</span></div>
      <div class="nav-item" onclick="showScreen('alerts')"><div class="nav-icon">🔔</div><span class="nav-label inactive">Alerts</span></div>
      <div class="nav-item" onclick="showScreen('settings')"><div class="nav-icon">⚙️</div><span class="nav-label inactive">Settings</span></div>
    </div>
  </div>
 
  <!-- ADD ITEM -->
  <div class="screen" id="screen-add">
    <div class="topbar">
      <div class="topbar-row">
        <button class="back-btn" onclick="showScreen('home')">←</button>
        <h1 id="add-screen-title" style="font-size:20px;">Add food item</h1>
      </div>
    </div>
    <div class="add-body">
      <input type="hidden" id="edit-id" value="">
      <div class="field-group">
        <div class="field-label">Food name</div>
        <input class="field-input" type="text" id="input-name" placeholder="e.g. Greek Yogurt, Apples...">
      </div>
      <div class="field-group">
        <div class="field-label">Quantity</div>
        <div class="qty-row">
          <button class="qty-btn" onclick="changeQty(-1)">−</button>
          <span class="qty-val" id="qty-display">1</span>
          <button class="qty-btn" onclick="changeQty(1)">+</button>
          <select class="unit-select" id="input-unit">
            <option>pcs</option><option>g</option><option>kg</option>
            <option>ml</option><option>L</option><option>cups</option>
          </select>
        </div>
      </div>
      <div class="field-group">
        <div class="field-label">Expiry date</div>
        <input class="field-input" type="date" id="input-expiry">
      </div>
      <div class="field-group">
        <div class="field-label">Category</div>
        <div class="pills-row" id="cat-pills">
          <div class="pill selected" onclick="selectPill(this,'cat-pills')">🥛 Dairy</div>
          <div class="pill" onclick="selectPill(this,'cat-pills')">🥦 Vegetables</div>
          <div class="pill" onclick="selectPill(this,'cat-pills')">🍎 Fruits</div>
          <div class="pill" onclick="selectPill(this,'cat-pills')">🍞 Grains</div>
          <div class="pill" onclick="selectPill(this,'cat-pills')">🥩 Meat</div>
          <div class="pill" onclick="selectPill(this,'cat-pills')">🥤 Drinks</div>
          <div class="pill" onclick="selectPill(this,'cat-pills')">🍳 Other</div>
        </div>
      </div>
      <div class="field-group">
        <div class="field-label">Alert me before expiry</div>
        <div class="pills-row" id="alert-pills">
          <div class="pill" onclick="selectPill(this,'alert-pills')">Same day</div>
          <div class="pill selected" onclick="selectPill(this,'alert-pills')">1 day</div>
          <div class="pill" onclick="selectPill(this,'alert-pills')">2 days</div>
          <div class="pill" onclick="selectPill(this,'alert-pills')">3 days</div>
        </div>
      </div>
      <button class="save-btn" onclick="saveItem()">Save item</button>
    </div>
  </div>
 
  <!-- ALERTS -->
  <div class="screen" id="screen-alerts">
    <div class="topbar">
      <div class="topbar-row">
        <div>
          <h1 style="font-size:22px;">Alerts</h1>
          <p class="sub" id="alerts-subtitle">No alerts right now</p>
        </div>
      </div>
    </div>
    <div class="screen-body"><div id="alerts-list" style="padding-top:12px;"></div></div>
    <div class="bottom-nav">
      <div class="nav-item" onclick="showScreen('home')"><div class="nav-icon">🏠</div><span class="nav-label inactive">Home</span></div>
      <div class="nav-item" onclick="showScreen('alerts')"><div class="nav-icon active">🔔</div><span class="nav-label active">Alerts</span></div>
      <div class="nav-item" onclick="showScreen('settings')"><div class="nav-icon">⚙️</div><span class="nav-label inactive">Settings</span></div>
    </div>
  </div>
 
  <!-- SETTINGS -->
  <div class="screen" id="screen-settings">
    <div class="topbar"><h1 style="font-size:22px;font-family:'DM Serif Display',serif;font-weight:400;">Settings</h1></div>
    <div class="settings-body">
      <div class="profile-card">
        <div class="avatar">👤</div>
        <div><div style="font-size:15px;font-weight:500;color:var(--g800);">My Pantry</div><div style="font-size:12px;color:var(--text-muted);">FoodSaver user</div></div>
        <span class="s-arrow" style="margin-left:auto;">›</span>
      </div>
      <div class="settings-section-label">Notifications</div>
      <div class="settings-group">
        <div class="settings-row"><span class="s-icon">🔔</span><div class="s-text"><div class="s-name">Push notifications</div><div class="s-sub">Alert before items expire</div></div><div class="toggle on" onclick="toggleSwitch(this)"><div class="toggle-knob"></div></div></div>
        <div class="settings-row"><span class="s-icon">⏰</span><div class="s-text"><div class="s-name">Alert time</div><div class="s-sub">9:00 AM every day</div></div><span class="s-arrow">›</span></div>
        <div class="settings-row"><span class="s-icon">📋</span><div class="s-text"><div class="s-name">Weekly summary</div><div class="s-sub">Every Sunday morning</div></div><div class="toggle on" onclick="toggleSwitch(this)"><div class="toggle-knob"></div></div></div>
      </div>
      <div class="settings-section-label">Preferences</div>
      <div class="settings-group">
        <div class="settings-row"><span class="s-icon">🌿</span><div class="s-text"><div class="s-name">Eco tips</div><div class="s-sub">Show recipes for expiring food</div></div><div class="toggle on" onclick="toggleSwitch(this)"><div class="toggle-knob"></div></div></div>
        <div class="settings-row"><span class="s-icon">📦</span><div class="s-text"><div class="s-name">Default unit</div><div class="s-sub">Pieces (pcs)</div></div><span class="s-arrow">›</span></div>
      </div>
      <div class="settings-section-label">Data</div>
      <div class="settings-group">
        <div class="settings-row" onclick="confirmClear()"><span class="s-icon">🗑️</span><div class="s-text"><div class="s-name">Clear all items</div><div class="s-sub" style="color:var(--red);">Remove all saved food</div></div><span class="s-arrow">›</span></div>
      </div>
      <div class="version-text">FoodSaver v1.0 · Reducing food waste, one item at a time 💚</div>
    </div>
    <div class="bottom-nav">
      <div class="nav-item" onclick="showScreen('home')"><div class="nav-icon">🏠</div><span class="nav-label inactive">Home</span></div>
      <div class="nav-item" onclick="showScreen('alerts')"><div class="nav-icon">🔔</div><span class="nav-label inactive">Alerts</span></div>
      <div class="nav-item" onclick="showScreen('settings')"><div class="nav-icon active">⚙️</div><span class="nav-label active">Settings</span></div>
    </div>
  </div>
</div>
 
<div class="modal-overlay" id="delete-modal">
  <div class="modal"><div class="modal-handle"></div><div class="modal-title">Remove this item?</div><p style="font-size:14px;color:var(--text-muted);">This action cannot be undone.</p><div class="modal-actions"><button class="btn-cancel" onclick="closeModal()">Cancel</button><button class="btn-confirm" onclick="confirmDelete()">Remove</button></div></div>
</div>
<div class="modal-overlay" id="clear-modal">
  <div class="modal"><div class="modal-handle"></div><div class="modal-title">Clear all food items?</div><p style="font-size:14px;color:var(--text-muted);">All your saved food will be permanently removed.</p><div class="modal-actions"><button class="btn-cancel" onclick="closeClearModal()">Cancel</button><button class="btn-confirm" onclick="doClear()">Clear all</button></div></div>
</div>
<div class="toast" id="toast"></div>
 
<script>
const EMOJI_MAP={'🥛 Dairy':'🥛','🥦 Vegetables':'🥦','🍎 Fruits':'🍎','🍞 Grains':'🍞','🥩 Meat':'🥩','🥤 Drinks':'🥤','🍳 Other':'🍳'};
let foods=JSON.parse(localStorage.getItem('foodsaver_v2')||'[]');
let qty=1,deleteTarget=null;
function saveData(){localStorage.setItem('foodsaver_v2',JSON.stringify(foods));}
function daysUntil(d){const n=new Date();n.setHours(0,0,0,0);const e=new Date(d);e.setHours(0,0,0,0);return Math.round((e-n)/86400000);}
function statusOf(f){const d=daysUntil(f.expiry);if(d<0)return'expired';if(d===0)return'urgent';if(d<=3)return'warn';return'fresh';}
function showScreen(n){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById('screen-'+n).classList.add('active');if(n==='home')renderHome();if(n==='alerts')renderAlerts();window.scrollTo(0,0);}
function renderHome(){
  const q=(document.getElementById('search-input').value||'').toLowerCase();
  const fl=foods.filter(f=>f.name.toLowerCase().includes(q));
  const exp=fl.filter(f=>statusOf(f)==='expired'),urg=fl.filter(f=>statusOf(f)==='urgent'),warn=fl.filter(f=>statusOf(f)==='warn'),fresh=fl.filter(f=>statusOf(f)==='fresh');
  document.getElementById('stat-total').textContent=foods.length;
  document.getElementById('stat-expiring').textContent=exp.length+urg.length+warn.length;
  document.getElementById('stat-fresh').textContent=fresh.length;
  const ec=exp.length+urg.length+warn.length;
  document.getElementById('home-subtitle').textContent=foods.length===0?'Add your first food item 🌿':ec>0?`${ec} item${ec>1?'s':''} expiring soon`:'All items are fresh 🌿';
  let html='';
  if(exp.length){html+=`<div class="section-head"><span class="section-title urgent">Expired</span><span class="section-count">${exp.length}</span></div><div class="food-list">${exp.map(cardHTML).join('')}</div>`;}
  if(urg.length){html+=`<div class="section-head"><span class="section-title urgent">Expiring today</span><span class="section-count">${urg.length}</span></div><div class="food-list">${urg.map(cardHTML).join('')}</div>`;}
  if(warn.length){html+=`<div class="section-head"><span class="section-title warn">Expiring soon</span><span class="section-count">${warn.length}</span></div><div class="food-list">${warn.map(cardHTML).join('')}</div>`;}
  if(fresh.length){html+=`<div class="section-head"><span class="section-title fresh">Fresh</span><span class="section-count">${fresh.length}</span></div><div class="food-list">${fresh.map(cardHTML).join('')}</div>`;}
  if(fl.length===0){html=`<div class="empty-state"><div class="empty-icon">🛒</div><div class="empty-title">${q?'No results found':'Your pantry is empty'}</div><p>${q?'Try a different search term.':'Start tracking your food to reduce waste and save money.'}</p>${!q?`<button class="empty-cta" onclick="openAdd()">+ Add your first item</button>`:''}</div>`;}
  document.getElementById('home-list').innerHTML=html;
}
function cardHTML(f){
  const st=statusOf(f),d=daysUntil(f.expiry),em=EMOJI_MAP[f.cat]||'🍳';
  let bc='badge-fresh',bt=`${d}d left`,cc='',bg='fresh-bg';
  if(st==='expired'){bc='badge-urgent';bt='Expired';cc='urgent-card';bg='urgent-bg';}
  else if(st==='urgent'){bc='badge-urgent';bt='Today';cc='urgent-card';bg='urgent-bg';}
  else if(st==='warn'){bc='badge-warn';bt=`${d}d left`;cc='warn-card';bg='warn-bg';}
  return`<div class="food-card ${cc}"><div class="food-emoji ${bg}">${em}</div><div class="food-info"><div class="food-name">${f.name}</div><div class="food-meta">${f.qty} ${f.unit} · Expires ${fmt(f.expiry)}</div></div><span class="food-badge ${bc}">${bt}</span><div class="food-actions"><button class="action-btn edit-btn" onclick="openEdit(${f.id})">✏️</button><button class="action-btn del-btn" onclick="askDelete(${f.id})">🗑️</button></div></div>`;
}
function fmt(s){return new Date(s+'T00:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'});}
function renderAlerts(){
  const ai=foods.filter(f=>daysUntil(f.expiry)<=3).sort((a,b)=>daysUntil(a.expiry)-daysUntil(b.expiry));
  document.getElementById('alerts-subtitle').textContent=ai.length>0?`${ai.length} item${ai.length>1?'s':''} need attention`:'No alerts right now 🎉';
  if(!ai.length){document.getElementById('alerts-list').innerHTML=`<div class="empty-state"><div class="empty-icon">🎉</div><div class="empty-title">All clear!</div><p>No items expiring soon. Keep it up!</p></div>`;return;}
  const tips={'🥛 Dairy':'Try making a smoothie or use in oatmeal.','🥦 Vegetables':'Great for stir-fry, soups, or steaming.','🍎 Fruits':'Perfect for a fruit salad or smoothie.','🍞 Grains':'Toast it or make croutons.','🥩 Meat':'Cook and freeze it before it expires.','🥤 Drinks':'Enjoy it chilled today!','🍳 Other':'Use it up before it goes to waste!'};
  const urg=ai.filter(f=>daysUntil(f.expiry)<=0),soon=ai.filter(f=>daysUntil(f.expiry)>0);
  let html='';
  if(urg.length){html+=`<div class="section-head"><span class="section-title urgent">Urgent</span></div>`;urg.forEach(f=>{html+=`<div class="alert-card urgent"><div class="alert-header"><div class="alert-title">${EMOJI_MAP[f.cat]||'🍳'} ${f.name} — ${daysUntil(f.expiry)<0?'expired':'expires today'}</div><div class="alert-time">Now</div></div><div class="alert-body">${tips[f.cat]||'Use it up!'}</div><div class="alert-actions"><button class="alert-action-btn" onclick="markUsed(${f.id})">✓ Mark as used</button><button class="alert-action-btn" onclick="openEdit(${f.id});showScreen('add')">Edit</button></div></div>`;});}
  if(soon.length){html+=`<div class="section-head"><span class="section-title warn">Expiring this week</span></div>`;soon.forEach(f=>{const d=daysUntil(f.expiry);html+=`<div class="alert-card warn"><div class="alert-header"><div class="alert-title">${EMOJI_MAP[f.cat]||'🍳'} ${f.name} — ${d} day${d>1?'s':''} left</div><div class="alert-time">${d}d</div></div><div class="alert-body">${tips[f.cat]||'Use it up!'}</div><div class="alert-actions"><button class="alert-action-btn" onclick="markUsed(${f.id})">✓ Mark as used</button><button class="alert-action-btn" onclick="openEdit(${f.id});showScreen('add')">Edit</button></div></div>`;});}
  html+=`<div class="alert-card info" style="margin-top:4px;"><div class="alert-header"><div class="alert-title">🌱 Eco tip</div></div><div class="alert-body">Plan your meals around expiring items first. It's the easiest way to cut food waste at home.</div></div>`;
  document.getElementById('alerts-list').innerHTML=html;
}
function markUsed(id){foods=foods.filter(f=>f.id!==id);saveData();renderAlerts();renderHome();showToast('Item marked as used ✓');}
function openAdd(){document.getElementById('edit-id').value='';document.getElementById('add-screen-title').textContent='Add food item';document.getElementById('input-name').value='';qty=1;document.getElementById('qty-display').textContent=1;document.getElementById('input-unit').value='pcs';const t=new Date();t.setDate(t.getDate()+7);document.getElementById('input-expiry').value=t.toISOString().split('T')[0];resetPills('cat-pills',0);resetPills('alert-pills',1);showScreen('add');}
function openEdit(id){const f=foods.find(x=>x.id===id);if(!f)return;document.getElementById('edit-id').value=id;document.getElementById('add-screen-title').textContent='Edit food item';document.getElementById('input-name').value=f.name;qty=f.qty;document.getElementById('qty-display').textContent=qty;document.getElementById('input-unit').value=f.unit;document.getElementById('input-expiry').value=f.expiry;document.querySelectorAll('#cat-pills .pill').forEach(p=>p.classList.toggle('selected',p.textContent.trim()===f.cat));document.querySelectorAll('#alert-pills .pill').forEach(p=>p.classList.toggle('selected',p.textContent.trim()===f.alert));showScreen('add');}
function saveItem(){const name=document.getElementById('input-name').value.trim(),expiry=document.getElementById('input-expiry').value;if(!name){showToast('Please enter a food name');return;}if(!expiry){showToast('Please select an expiry date');return;}const cat=(document.querySelector('#cat-pills .pill.selected')||{textContent:'🍳 Other'}).textContent.trim();const alert=(document.querySelector('#alert-pills .pill.selected')||{textContent:'1 day'}).textContent.trim();const unit=document.getElementById('input-unit').value;const editId=document.getElementById('edit-id').value;if(editId){const i=foods.findIndex(f=>f.id===parseInt(editId));if(i>-1){foods[i]={...foods[i],name,qty,unit,expiry,cat,alert};showToast('Item updated ✓');}}else{foods.push({id:Date.now(),name,qty,unit,expiry,cat,alert});showToast('Item added ✓');}saveData();showScreen('home');}
function changeQty(d){qty=Math.max(1,qty+d);document.getElementById('qty-display').textContent=qty;}
function selectPill(el,gid){document.querySelectorAll(`#${gid} .pill`).forEach(p=>p.classList.remove('selected'));el.classList.add('selected');}
function resetPills(gid,di){document.querySelectorAll(`#${gid} .pill`).forEach((p,i)=>p.classList.toggle('selected',i===di));}
function askDelete(id){deleteTarget=id;document.getElementById('delete-modal').classList.add('open');}
function closeModal(){document.getElementById('delete-modal').classList.remove('open');deleteTarget=null;}
function confirmDelete(){if(deleteTarget!==null){foods=foods.filter(f=>f.id!==deleteTarget);saveData();renderHome();renderAlerts();showToast('Item removed');}closeModal();}
function confirmClear(){document.getElementById('clear-modal').classList.add('open');}
function closeClearModal(){document.getElementById('clear-modal').classList.remove('open');}
function doClear(){foods=[];saveData();renderHome();renderAlerts();closeClearModal();showToast('All items cleared');}
function toggleSwitch(el){el.classList.toggle('on');el.classList.toggle('off');}
function showToast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2500);}
renderHome();
</script>
</body>
</html>
 
